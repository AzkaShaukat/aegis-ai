# Aegis AI — Environment Configuration v4.0.0
# Copy to .env and fill in your keys. All optional — runs offline without keys.

# ── Tier 1 ────────────────────────────────────────────────────────────────────
HIBP_API_KEY=          # haveibeenpwned.com — $3.50/mo
DEHASHED_EMAIL=        # dehashed.com — free account
DEHASHED_API_KEY=
HUNTER_API_KEY=        # hunter.io — 25 req/month free
WHOISXML_API_KEY=      # whoisxmlapi.com — 500 req/month free

# ── Tier 3 Phone ──────────────────────────────────────────────────────────────
NUMVERIFY_API_KEY=     # numverify.com — 100 req/month free
ABSTRACT_API_KEY=      # abstractapi.com — 100 req/month free

# ── Tier 5 Advanced Phone ─────────────────────────────────────────────────────
# ★ EXCEPTIONAL: IPQualityScore — 5000 req/month FREE
# Returns fraud_score, VOIP, prepaid, active, risky, carrier, leaked
# Register: https://www.ipqualityscore.com/user/register
IPQS_API_KEY=

# ── Tier 4 Key Breach ─────────────────────────────────────────────────────────
LEAKCHECK_API_KEY=     # leakcheck.io — 10 req/day free

# ── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis_t1:6379/0
LOG_LEVEL=INFO
HTTP_TIMEOUT=12.0

# ── Production Features ───────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=60        # 0 = disable rate limiting
AEGIS_API_KEY=               # empty = no auth required (open for dev)
                             # Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_URL=                 # POST alerts for high-risk detections
WEBHOOK_MIN_RISK=76          # Only fire webhook for risk >= this score
