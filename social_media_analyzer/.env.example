# ══════════════════════════════════════════════════════════════════════════════
# AEGIS AI — Unified Fake Profile Detector — Environment Configuration
# Copy to .env and fill in the keys you have. ALL keys are optional.
# ══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
# Set a random string to protect the API with X-API-Key header
AEGIS_API_KEY=
REDIS_URL=redis://redis:6379

# ── Block 2: Link Safety ──────────────────────────────────────────────────────
# VirusTotal — malicious URL check (500/day free)
# Sign up at: virustotal.com/gui/sign-in
VIRUSTOTAL_API_KEY=

# URLScan.io — full page scan (1000/day free)
# Sign up at: urlscan.io/user/register
URLSCAN_API_KEY=

# WhoisXML — domain age lookup (500/month free)
# Sign up at: whoisxmlapi.com
WHOISXML_API_KEY=

# ── Block 2/3: Phone & Email ──────────────────────────────────────────────────
# IPQualityScore — phone + email fraud detection (5000/month free)
# Sign up at: ipqualityscore.com
IPQS_API_KEY=

# ── Block 3: OSINT / Breach ───────────────────────────────────────────────────
# LeakCheck.io — breach lookup (10/day FREE, more with key)
# Sign up at: leakcheck.io
LEAKCHECK_API_KEY=

# BreachDirectory — breach lookup (FREE, no key, no signup needed!)
# https://breachdirectory.org — works automatically

# Have I Been Pwned — email breach check (FREE API key, no cost)
# Get your key at: haveibeenpwned.com/API/v3
# Takes 30 seconds to register — highly recommended
HIBP_API_KEY=

# Shodan — IP/domain exposure (100/month free)
# Register at: account.shodan.io/register
SHODAN_API_KEY=

# GreyNoise — IP reputation (community FREE, no key needed)
GREYNOISE_API_KEY=

# HudsonRock Cavalier — stealer logs (FREE, no key needed)
HUDSONROCK_ENABLED=true

# Botometer Pro — Twitter bot score (RapidAPI, paid)
BOTOMETER_API_KEY=

# ── Block 4: Ollama (LOCAL — 100% free, zero data sent externally) ────────────
# Install: https://ollama.ai/download
#
# Text model (for holistic profile scoring):
#   ollama pull mistral       ← recommended (4.1 GB)
#   ollama pull llama3.2:3b   ← faster, smaller (2.0 GB)
#
# Vision model (for profile picture analysis):
#   ollama pull llava:7b      ← recommended (4.5 GB)
#   ollama pull llava:13b     ← higher quality (8.0 GB)
#
# Verify Ollama is running:
#   curl http://localhost:11434/api/tags
#
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_ENABLED=true
OLLAMA_VISION_ENABLED=true

# ── Block 4: sklearn ──────────────────────────────────────────────────────────
SKLEARN_ENABLED=true
SKLEARN_MODEL_PATH=/app/models/rf_model.pkl
