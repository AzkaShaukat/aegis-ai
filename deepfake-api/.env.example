# ============================================================
# Aegis AI — Deepfake Detection API (.env.example)
# Copy to .env and edit.
# ============================================================

# Model paths (place .pth files in app/models/)
IMAGE_EFFICIENTNET_PATH=app/models/efficientnet_best.pth
IMAGE_VIT_PATH=app/models/vit_best.pth
IMAGE_FREQCNN_PATH=app/models/freqcnn_best.pth
IMAGE_ENSEMBLE_CONFIG=app/models/ensemble_config.json

VIDEO_SPATIAL_PATH=app/models/spatial_best.pth
VIDEO_TEMPORAL_PATH=app/models/temporal_best.pth
VIDEO_FREQ_SRM_PATH=app/models/freq_srm_best.pth
VIDEO_ENSEMBLE_CONFIG=app/models/ensemble_video_config.json

# Device (auto = CUDA if available, else CPU)
DEVICE=auto

# Video — no practical limit
MAX_VIDEO_SIZE_MB=99999
VIDEO_FPS_EXTRACT=1

# Redis — uses container name for Docker DNS
# Port 6380 on host maps to 6379 inside container
REDIS_URL=redis://aegis_deepfake_redis:6379/0

# API
PORT=8004
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
