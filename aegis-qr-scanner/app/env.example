# ══════════════════════════════════════════════════════════════
# Aegis QR Scanner v5.1 — .env.example
# Copy to .env and fill in your keys.
# [NO KEY NEEDED] = works with zero configuration.
# [REUSE]         = copy from your Link Analyzer .env
# ══════════════════════════════════════════════════════════════

# ─── Infrastructure ──────────────────────────────────────────
REDIS_URL=redis://redis:6379
LINK_ANALYZER_URL=http://host.docker.internal:8000
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2


# ─── Phase 3: External Intelligence Keys ─────────────────────

# URLHaus (Abuse.ch)   [NO KEY NEEDED] — URL malware/phishing DB, runs automatically

# EmailRep.io          [NO KEY NEEDED] — email breach/spam/disposable check, runs automatically
# Optional: add key below for 1000+/hour instead of 10/hour
# Register free: https://emailrep.io/key
EMAILREP_KEY=

# Google Safe Browsing [REUSE from Link Analyzer .env]
# Copy your existing GSB_API_KEY here — no new registration
GSB_API_KEY=

# AbuseIPDB            [NEW — free registration]
# Triggered only for QR codes with raw IP addresses in the URL
# Register: https://www.abuseipdb.com/register
ABUSEIPDB_KEY=

# NumVerify            [REUSE from Phase 1 / existing Link Analyzer setup]
# Used in Phase 1 v4 for phone enrichment. Copy existing key.
# Register free (100 calls/month): https://numverify.com/
NUMVERIFY_KEY=


# Chainabuse           [NEW — user has key]
# Successor to BitcoinAbuse. Supports Bitcoin, ETH, LTC, XMR + 40 more coins.
# Register: https://www.chainabuse.com/api
CHAINABUSE_KEY=


# ─── Removed in v5.1 (do not add these) ─────────────────────
# IPQS_KEY=         → replaced by URLHaus (free) + GSB (reused)
# HIBP_KEY=         → replaced by EmailRep.io (free, same data + more)
# BITCOINABUSE_KEY= → platform merged into Chainabuse
# PHISHTANK_KEY=    → registration disabled; Link Analyzer already covers URL phishing
