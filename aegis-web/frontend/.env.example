# Frontend environment variables
# Copy to .env.local — Vite will load this automatically

# Backend API URL (used only if NOT using Vite dev proxy)
# In development, leave empty — the Vite proxy in vite.config.ts handles routing
VITE_API_BASE_URL=

# In production, set this to your deployed backend:
# VITE_API_BASE_URL=https://api.yourdomain.com
