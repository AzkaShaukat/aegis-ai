# ============================================================
# Aegis AI Web — Environment Configuration
# Copy to .env.web and fill in your values.
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_PORT=8007

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://aegis:aegispass@localhost:5432/aegis_web
POSTGRES_PASSWORD=aegispass

# Redis (your existing Redis on 6379, web uses DB 4 & 5)
REDIS_URL=redis://localhost:6379/4
REDIS_RATE_LIMIT_URL=redis://localhost:6379/5

# JWT — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:5173

# Email (Gmail with App Password)
# 1. Enable 2FA on Google account
# 2. myaccount.google.com/apppasswords → create App Password
# 3. Fill in below and set EMAIL_ENABLED=true
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM_NAME=Aegis AI
SMTP_FROM_EMAIL=your_email@gmail.com

# Microservices (same as WA project)
LINK_ANALYZER_URL=http://localhost:8000
QR_SCANNER_URL=http://localhost:8001
CREDENTIAL_ANALYZER_URL=http://localhost:8002
PROFILE_ANALYZER_URL=http://localhost:8003
DEEPFAKE_SERVICE_URL=http://localhost:8004
CREDENTIAL_API_KEY=1122
PROFILE_API_KEY=1122

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_ENABLED=true

# Gemini (optional)
GEMINI_API_KEY=

# Uploads
UPLOAD_MAX_SIZE_MB=25
UPLOAD_DIR=/tmp/aegis_uploads
